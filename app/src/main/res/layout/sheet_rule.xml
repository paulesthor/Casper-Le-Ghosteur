<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="20dp">

    <include layout="@layout/sheet_grab" />

    <include
        android:id="@+id/head"
        layout="@layout/sheet_head" />

    <TextView
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Me relancer si je n'ai pas répondu après"
        android:textSize="13sp" />

    <com.paulesthor.casper.FlowLayout
        android:id="@+id/delays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Puis"
        android:textSize="13sp" />

    <com.paulesthor.casper.FlowLayout
        android:id="@+id/repeats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/apps_label"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Sur"
        android:textSize="13sp" />

    <com.paulesthor.casper.FlowLayout
        android:id="@+id/apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/summary"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_icon_tile"
        android:lineSpacingMultiplier="1.2"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/secondary"
            style="@style/Text.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/primary"
            style="@style/Text.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Enregistrer" />
    </LinearLayout>
</LinearLayout>
