<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.paulesthor.casper.BlobBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Padded by the system bar insets in code. -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/page_inbox"
            layout="@layout/page_inbox" />

        <include
            android:id="@+id/page_reminders"
            layout="@layout/page_reminders"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/tabbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:id="@+id/tab_inbox"
                style="@style/Text.Name"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:drawableStart="@drawable/ic_list"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tab_reminders"
                style="@style/Text.Name"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:drawableStart="@drawable/ic_bell"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:text="Rappels"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
