<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.paulesthor.casper.BlobBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Padded by the system bar insets in code. -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/page_inbox"
            layout="@layout/page_inbox" />

        <include
            android:id="@+id/page_reminders"
            layout="@layout/page_reminders"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/snack"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="84dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="22dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/snack_text"
                style="@style/Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/snack_action"
                style="@style/Text.Name"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="@font/inter_bold"
                android:gravity="center"
                android:paddingStart="16dp"
                android:text="Annuler"
                android:textColor="@color/accent"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:id="@+id/tab_inbox"
                style="@style/Text.Name"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:drawableStart="@drawable/ic_list"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tab_reminders"
                style="@style/Text.Name"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:drawableStart="@drawable/ic_bell"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:text="Rappels"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
